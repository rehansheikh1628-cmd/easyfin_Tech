{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_PROD_SQL_SERVER;Database=EasyFin_Tech;User Id=YOUR_PROD_USER;Password=YOUR_PROD_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://YOUR-PRODUCTION-DOMAIN"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "FileUpload": {
    "MaxPdfSizeBytes": 262144000,
    "StorageRoot": "Storage/Statements",
    "StorageProvider": "Local",
    "AllowedExtensions": [ ".pdf" ],
    "AllowedContentTypes": [ "application/pdf" ],
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "statements"
    }
  },
  "BackgroundProcessing": {
    "MaxConcurrentJobs": 2,
    "QueueCapacity": 100,
    "JobTimeoutMinutes": 15
  },
  "AllowedHosts": "*"
}
