{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=EasyFin_Tech;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:64991",
      "https://localhost:64991"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileUpload": {
    "MaxPdfSizeBytes": 262144000,
    "StorageRoot": "Storage/Statements",
    "StorageProvider": "Local",
    "AllowedExtensions": [ ".pdf" ],
    "AllowedContentTypes": [ "application/pdf" ],
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "statements"
    }
  },
  "BackgroundProcessing": {
    "MaxConcurrentJobs": 2,
    "QueueCapacity": 100,
    "JobTimeoutMinutes": 15
  }
}

